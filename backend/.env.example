# Django 기본 설정
SECRET_KEY=your-secret-key-here-generate-new-one
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# 데이터베이스 (개발 환경에서는 SQLite 사용, 프로덕션에서는 PostgreSQL)
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=db.sqlite3
# DB_USER=
# DB_PASSWORD=
# DB_HOST=
# DB_PORT=

# 프로덕션 PostgreSQL 예시 (주석 해제 후 사용)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=ssafy_capstone
DB_USER=ssafy_user
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432

# Pred API URL
ML_API_URL=http://pred:8001

# SMTP 설정 (Gmail 예시)
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend  # 개발 환경
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=example@gmail.com
EMAIL_HOST_PASSWORD=app_password_16chars
EMAIL_VERIFICATION_FROM_EMAIL=example@gmail.com
EMAIL_VERIFICATION_CODE_LENGTH=6
EMAIL_VERIFICATION_EXPIRES_MINUTES=30
EMAIL_TIMEOUT=5

# 프론트엔드 URL (OAuth 리다이렉트용)
FRONTEND_BASE_URL=http://localhost:5173

# JWT
JWT_ACCESS_TOKEN_LIFETIME=15
JWT_REFRESH_TOKEN_LIFETIME=7
DEFAULT_ROLE=guest
ADMIN_EMAIL_WHITELIST=admin@example.com
PASSWORD_RESET_RETURN_TOKEN_IN_RESPONSE=false

# Google OAuth2
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:8000/auth/google/callback/

# Kakao OAuth2
KAKAO_REST_API_KEY=your_kakao_rest_api_key
KAKAO_CLIENT_SECRET=
KAKAO_CALLBACK_URL=http://localhost:8000/auth/kakao/callback/


# 스케줄러 비활성화
PIPELINE_ENABLED=true
# 초기 대기 시간 변경 (기본: 30초)
PIPELINE_INITIAL_DELAY=30
# 실행 간격 변경 (기본: 3600초 = 1시간)
PIPELINE_INTERVAL=1800  # 30분

# 크롤러·스토어·알림·S3 설정 (크롤러/데이터 파이프라인 공통)
# 크롤 타깃/동시성/딜레이/범위
CRAWL_TARGET=target_crawl
CRAWL_CONCURRENCY=1
CRAWL_DELAY_MS=500
CRAWL_SCOPE=full

# 홈플러스 스토어·배송 기본값 (env로 오버라이드 가능)
STORE_ID=37
STORE_TYPE=HYPER
STORE_KIND=NOR
ITEM_SHIP_METHOD=TD_DRCT

# 알림 설정 (Slack + 이메일)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
ALERT_EMAIL=your_email

# S3 업로드 설정 (raw HTML/스크린샷 월 1회 업로드)
S3_BUCKET=your_s3_bucket
S3_PREFIX=your_s3_prefix

# AWS S3 설정 (판매자 상품 이미지 업로드용)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET=self-json-backup
AWS_S3_REGION=ap-northeast-2
AWS_S3_THUMBNAIL_PREFIX=homeplus/thumnail/
AWS_S3_PRODUCT_DETAIL_PREFIX=homeplus/product_detail/

# GMS (SSAFY GPT Proxy) 설정 - 상품명에서 재료 추출용
GMS_API_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1
GMS_API_KEY=your_gms_api_key_here
GMS_MODEL=gpt-4o-mini
GMS_MAX_RETRIES=3
GMS_TIMEOUT=30

# Celery 설정 (GMS 비동기 추출용)
REDIS_URL=redis://redis:6379/0
CELERY_CONCURRENCY=4
GMS_EXTRACTION_BATCH_SIZE=100
GMS_EXTRACTION_MIN_CONFIDENCE=0.7
GMS_EXTRACTION_USE_FALLBACK=True

# 서버 시작 시 GMS 미처리 상품 자동 발행 여부 (기본: true)
GMS_AUTO_TRIGGER_ON_STARTUP=true

# ========================= 토스페이먼츠 PG 설정 =========================
# 결제 모드: 'demo' (데모 모드) 또는 'production' (실제 PG)
PAYMENT_MODE=demo

# 토스페이먼츠 API 키 (https://developers.tosspayments.com/)
# 테스트 키: test_ck_..., test_sk_...
# 라이브 키: live_ck_..., live_sk_...
TOSS_CLIENT_KEY=test_gck_docs_Ovk5rk1EwkEbP0W43n07xlzm
TOSS_SECRET_KEY=test_gsk_docs_OaPz8L5KdmQXkzRz3y47BMw6

# 토스페이먼츠 API URL (기본값 사용)
TOSS_API_URL=https://api.tosspayments.com/v1

# 웹훅 시그니처 검증 키 (토스 대시보드에서 발급, 선택사항)
TOSS_WEBHOOK_SECRET=

# 프론트엔드 URL (토스 결제 후 리다이렉트)
FRONTEND_ORIGIN=http://localhost:8080
PAYMENT_SUCCESS_URL=http://localhost:8080/checkout/success
PAYMENT_FAIL_URL=http://localhost:8080/checkout/fail
