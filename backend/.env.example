# Django 기본 설정
SECRET_KEY=your-secret-key-here-generate-new-one
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# 데이터베이스 (개발 환경에서는 SQLite 사용, 프로덕션에서는 PostgreSQL)
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=db.sqlite3
# DB_USER=
# DB_PASSWORD=
# DB_HOST=
# DB_PORT=

# 프로덕션 PostgreSQL 예시 (주석 해제 후 사용)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=ssafy_capstone
DB_USER=ssafy_user
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432

# Pred API URL
ML_API_URL=http://pred:8001

# SMTP 설정 (Gmail 예시)
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend  # 개발 환경
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=example@gmail.com
EMAIL_HOST_PASSWORD=app_password_16chars
EMAIL_VERIFICATION_FROM_EMAIL=example@gmail.com
EMAIL_VERIFICATION_CODE_LENGTH=6
EMAIL_VERIFICATION_EXPIRES_MINUTES=30
EMAIL_TIMEOUT=5

# 프론트엔드 URL (OAuth 리다이렉트용)
FRONTEND_BASE_URL=http://localhost:5173

# JWT
JWT_ACCESS_TOKEN_LIFETIME=15
JWT_REFRESH_TOKEN_LIFETIME=7
DEFAULT_ROLE=guest
ADMIN_EMAIL_WHITELIST=admin@example.com
PASSWORD_RESET_RETURN_TOKEN_IN_RESPONSE=false

# Google OAuth2
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:8000/auth/google/callback/

# Kakao OAuth2
KAKAO_REST_API_KEY=your_kakao_rest_api_key
KAKAO_CLIENT_SECRET=
KAKAO_CALLBACK_URL=http://localhost:8000/auth/kakao/callback/


# 스케줄러 비활성화
PIPELINE_ENABLED=true
# 초기 대기 시간 변경 (기본: 30초)
PIPELINE_INITIAL_DELAY=30
# 실행 간격 변경 (기본: 3600초 = 1시간)
PIPELINE_INTERVAL=1800  # 30분

# 크롤러·스토어·알림·S3 설정 (크롤러/데이터 파이프라인 공통)
# 크롤 타깃/동시성/딜레이/범위
CRAWL_TARGET=target_crawl
CRAWL_CONCURRENCY=1
CRAWL_DELAY_MS=500
CRAWL_SCOPE=full

# 홈플러스 스토어·배송 기본값 (env로 오버라이드 가능)
STORE_ID=37
STORE_TYPE=HYPER
STORE_KIND=NOR
ITEM_SHIP_METHOD=TD_DRCT

# 알림 설정 (Slack + 이메일)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
ALERT_EMAIL=your_email

# S3 업로드 설정 (raw HTML/스크린샷 월 1회 업로드)
S3_BUCKET=your_s3_bucket
S3_PREFIX=your_s3_prefix
