# ===================================
# SelF Pred Service 환경 변수
# ===================================

# 서비스 설정
SERVICE_NAME=self-pred
SERVICE_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# 서버 설정
HOST=0.0.0.0
PORT=8001

# PostgreSQL 설정 (Django 백엔드와 동일 DB 사용)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=self_db
DB_USER=self_user
DB_PASSWORD=your_password
DB_MIN_CONNECTIONS=5
DB_MAX_CONNECTIONS=20

# Redis 설정
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# 캐시 TTL (초)
CACHE_TTL_RECOMMENDATION=1800
CACHE_TTL_PRICE_ANOMALY=3600
CACHE_TTL_USER_EMBEDDING=86400

# ML 모델 설정
BERT_MODEL_NAME=klue/bert-base
EMBEDDING_DIMENSION=768

# 타임아웃 설정 (밀리초)
MODEL_TIMEOUT_COLDSTART=100
MODEL_TIMEOUT_PERSONALIZED=200
MODEL_TIMEOUT_PRICE=150
MODEL_TIMEOUT_RECIPE=200
API_TIMEOUT=500

# 배치 처리 설정
BATCH_CHUNK_SIZE=1000
BATCH_SIMILARITY_TOP_K=100

# CORS 설정
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
