{
  "version": "1.2.0",
  "updated_at": "2025-12-21",
  "description": "SelF 추천 시스템 ML 모델 메타데이터",
  "active_models": {
    "self_personalized": "self_personalized_v2",
    "price_anomaly": "price_anomaly_v1",
    "instacart_cold_start": "instacart_cold_start_v1",
    "recipe_gap_filling": "recipe_gapfilling_v2"
  },
  "models": {
    "self_personalized_v2": {
      "description": "SelF 개인화 추천 모델 (ALS 32차원 + 하이브리드)",
      "version": "2.0.0",
      "algorithm": "ALS",
      "type": "als_hybrid",
      "academic_references": [
        "Hu, Y., Koren, Y., & Volinsky, C. (2008). Collaborative Filtering for Implicit Feedback Datasets. IEEE ICDM.",
        "Netflix Prize (2009). The BellKor Solution to the Netflix Grand Prize."
      ],
      "components": [
        "user_embeddings",
        "product_embeddings",
        "user_id_to_idx",
        "idx_to_product_id",
        "global_popular_products",
        "category_popular_products"
      ],
      "features": [
        "ALS 32차원 Latent Factor",
        "Confidence Weighting (α=15.0)",
        "동적 하이브리드 가중치 (CBF/CF)",
        "시간 감쇠 (λ=0.05)",
        "식료품 특화: 재구매 허용"
      ],
      "hyperparameters": {
        "factors": 32,
        "alpha": 15.0,
        "regularization": 0.01,
        "iterations": 15,
        "weight_view": 0.1,
        "weight_wishlist": 0.5,
        "weight_cart": 2.0,
        "weight_review": 4.0,
        "weight_order": 5.0,
        "cbf_weight": 0.7,
        "cf_weight": 0.3,
        "time_decay_lambda": 0.05,
        "filter_already_liked_items": false
      },
      "evaluation_targets": {
        "Recall@10": 0.15,
        "NDCG@10": 0.20,
        "HitRate@10": 0.70,
        "MRR@10": 0.25,
        "Coverage": 0.50
      },
      "memory_efficiency": "~1MB (기존 SVD 128D 대비 ~98% 절감)"
    },
    "self_personalized_v1": {
      "description": "SelF 개인화 추천 모델 (Truncated SVD 기반 협업 필터링) - 레거시",
      "version": "1.0.0",
      "type": "svd_embedding",
      "deprecated": true,
      "components": [
        "user_embeddings",
        "product_embeddings",
        "user_id_to_idx",
        "idx_to_user_id",
        "product_id_to_idx",
        "idx_to_product_id",
        "global_popular_products",
        "category_popular_products"
      ],
      "hyperparameters": {
        "n_components": 128,
        "weight_view": 1.0,
        "weight_cart": 3.0,
        "weight_order": 5.0
      }
    },
    "price_anomaly_v1": {
      "description": "가격 이상치 탐지 모델 (Modified Z-Score + 카테고리별 통계)",
      "version": "1.0.0",
      "type": "statistical_anomaly",
      "components": [
        "category_statistics",
        "global_statistics",
        "thresholds"
      ],
      "hyperparameters": {
        "warning_threshold": 2.5,
        "danger_threshold": 3.5,
        "use_log_transform": true,
        "method": "modified_z_score"
      }
    },
    "instacart_cold_start_v1": {
      "description": "Instacart 기반 Cold Start 추천 모델 (168 시간 패턴)",
      "version": "1.0.0",
      "type": "time_pattern",
      "components": [
        "time_patterns",
        "category_mapping",
        "aisle_stats",
        "global_popular_aisles"
      ],
      "hyperparameters": {
        "n_time_slots": 168,
        "min_orders_per_slot": 100
      }
    },
    "recipe_gapfilling_v1": {
      "description": "레시피 기반 재료 갭필링 추천 모델 (레거시)",
      "version": "1.0.0",
      "type": "recipe_based",
      "components": [
        "recipe_embeddings",
        "ingredient_mappings",
        "category_mappings"
      ],
      "deprecated": true
    },
    "recipe_gapfilling_v2": {
      "description": "Masked Set Transformer 기반 레시피 Gap Filling 모델",
      "version": "2.1.0",
      "type": "masked_set_transformer",
      "components": [
        "model",
        "tokenizer",
        "normalizer"
      ],
      "features": [
        "Stop Words 필터링 (비구매 재료 제외)",
        "IDF 가중치 적용",
        "256차원 임베딩",
        "6 Layer Transformer"
